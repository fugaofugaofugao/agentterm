{
  "name": "@termsync/electron",
  "version": "1.0.0",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.agentterm.monitor",
    "productName": "AgentTerm Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.map"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../server/public",
        "to": "server-public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/tmux",
        "to": "tmux",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "afterPack": "./scripts/sign-tmux.js"
  },
  "dependencies": {
    "@termsync/shared": "workspace:*",
    "node-pty": "^1.1.0",
    "@termsync/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  }
}
