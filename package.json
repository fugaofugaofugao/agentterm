{
  "name": "agentterm",
  "version": "1.0.1",
  "private": true,
  "description": "Remote monitor and control for Claude Code, Codex, Gemini CLI and AI terminal agents",
  "scripts": {
    "dev:server": "pnpm --filter @agentterm/server dev",
    "dev:electron": "pnpm --filter @agentterm/electron dev",
    "build:server": "pnpm --filter @agentterm/server build",
    "build:electron": "pnpm --filter @agentterm/electron build",
    "build:shared": "pnpm --filter @agentterm/shared build"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fugaofugaofugao/agentterm.git"
  },
  "homepage": "https://github.com/fugaofugaofugao/agentterm#readme",
  "bugs": {
    "url": "https://github.com/fugaofugaofugao/agentterm/issues"
  },
  "license": "Apache-2.0"
}
